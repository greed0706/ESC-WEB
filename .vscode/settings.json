{
  "liveSassCompile.settings.formats": [
    {
      "format": "compressed",
      "extensionName": ".css",
      "savePathReplacementPairs": { "src/scss": "assets/css" }
    }
  ],
  "liveSassCompile.settings.generateMap": false,
  "liveSassCompile.settings.partialsList": ["/**/_*.s[ac]ss"],
  "liveSassCompile.settings.excludeList": ["/**/node_modules/**"]
}
